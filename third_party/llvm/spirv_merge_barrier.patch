   initializeSPIRVRegularizerLegacyPass(PR);
   initializeSPIRVPreLegalizerPass(PR);
   initializeSPIRVPostLegalizerPass(PR);
+  initializeSPIRVFixupMergeTerminatorsPass(PR);
   initializeSPIRVMergeRegionExitTargetsLegacyPass(PR);
   initializeSPIRVEmitIntrinsicsLegacyPass(PR);
   initializeSPIRVPrepareFunctionsLegacyPass(PR);
@@ -136,1 +137,2 @@ public:
   void addPostRegAlloc() override;
+  void addPreEmitPass() override;
@@ -296,3 +298,7 @@ bool SPIRVPassConfig::addGlobalInstructionSelect() {
   addPass(new SPIRVInstructionSelect());
   return false;
 }
+
+void SPIRVPassConfig::addPreEmitPass() {
+  addPass(createSPIRVFixupMergeTerminatorsPass());
+}
diff --git a/llvm/test/CodeGen/SPIRV/merge-terminator-adjacency.mir b/llvm/test/CodeGen/SPIRV/merge-terminator-adjacency.mir
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/SPIRV/merge-terminator-adjacency.mir
@@ -0,0 +1,137 @@
+# RUN: llc -mtriple=spirv-unknown-vulkan-compute \
+# RUN:   -run-pass=spirv-fixup-merge-terminators -verify-machineinstrs %s \
+# RUN:   -o - | FileCheck %s
+
+--- |
+  target triple = "spirv-unknown-vulkan-compute"
+
+  define void @loop_branch() { ret void }
+  define void @loop_branch_conditional() { ret void }
+  define void @selection_branch_conditional() { ret void }
+  define void @selection_switch() { ret void }
+...
+---
+name: loop_branch
+legalized: true
+selected: true
+tracksRegLiveness: true
+body: |
+  ; CHECK-LABEL: name: loop_branch
+  bb.0:
+    successors: %bb.1
+
+    ; CHECK: OpNop
+    ; CHECK-NEXT: OpLoopMerge
+    ; CHECK-NEXT: OpBranch
+    OpLoopMerge %bb.2, %bb.1, 0
+    OpNop
+    OpBranch %bb.1
+
+  bb.1:
+    successors: %bb.0
+
+    OpBranch %bb.0
+
+  bb.2:
+    OpReturn
+...
+---
+name: loop_branch_conditional
+legalized: true
+selected: true
+tracksRegLiveness: true
+registers:
+  - { id: 0, class: type }
+  - { id: 1, class: iid }
+body: |
+  ; CHECK-LABEL: name: loop_branch_conditional
+  bb.0:
+    successors: %bb.1, %bb.2
+
+    %0:type = OpTypeBool
+    %1:iid = OpConstantTrue %0
+    ; CHECK: OpNop
+    ; CHECK-NEXT: OpLoopMerge
+    ; CHECK-NEXT: OpBranchConditional
+    OpLoopMerge %bb.2, %bb.1, 0
+    OpNop
+    OpBranchConditional %1, %bb.1, %bb.2
+
+  bb.1:
+    successors: %bb.0
+
+    OpBranch %bb.0
+
+  bb.2:
+    OpReturn
+...
+---
+name: selection_branch_conditional
+legalized: true
+selected: true
+tracksRegLiveness: true
+registers:
+  - { id: 0, class: type }
+  - { id: 1, class: iid }
+body: |
+  ; CHECK-LABEL: name: selection_branch_conditional
+  bb.0:
+    successors: %bb.1, %bb.2
+
+    %0:type = OpTypeBool
+    %1:iid = OpConstantTrue %0
+    ; CHECK: OpNop
+    ; CHECK-NEXT: OpSelectionMerge
+    ; CHECK-NEXT: OpBranchConditional
+    OpSelectionMerge %bb.3, 0
+    OpNop
+    OpBranchConditional %1, %bb.1, %bb.2
+
+  bb.1:
+    successors: %bb.3
+
+    OpBranch %bb.3
+
+  bb.2:
+    successors: %bb.3
+
+    OpBranch %bb.3
+
+  bb.3:
+    OpReturn
+...
+---
+name: selection_switch
+legalized: true
+selected: true
+tracksRegLiveness: true
+registers:
+  - { id: 0, class: type }
+  - { id: 1, class: iid }
+body: |
+  ; CHECK-LABEL: name: selection_switch
+  bb.0:
+    successors: %bb.1, %bb.2
+
+    %0:type = OpTypeInt 32, 0
+    %1:iid = OpConstantI %0, 0
+    ; CHECK: OpNop
+    ; CHECK-NEXT: OpSelectionMerge
+    ; CHECK-NEXT: OpSwitch
+    OpSelectionMerge %bb.3, 0
+    OpNop
+    OpSwitch %1, %bb.1, 0, %bb.2
+
+  bb.1:
+    successors: %bb.3
+
+    OpBranch %bb.3
+
+  bb.2:
+    successors: %bb.3
+
+    OpBranch %bb.3
+
+  bb.3:
+    OpReturn
+...
