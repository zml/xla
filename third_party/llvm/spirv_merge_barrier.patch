diff --git a/llvm/lib/Target/SPIRV/SPIRVFixupMergeTerminators.cpp b/llvm/lib/Target/SPIRV/SPIRVFixupMergeTerminators.cpp
new file mode 100644
--- /dev/null
+++ b/llvm/lib/Target/SPIRV/SPIRVFixupMergeTerminators.cpp
@@ -0,0 +1,92 @@
+//===-- SPIRVFixupMergeTerminators.cpp - Fix merge placement ------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "SPIRV.h"
+#include "SPIRVInstrInfo.h"
+#include "llvm/CodeGen/MachineBasicBlock.h"
+#include "llvm/CodeGen/MachineFunction.h"
+#include "llvm/CodeGen/MachineFunctionPass.h"
+#include "llvm/CodeGen/MachineInstr.h"
+#include "llvm/InitializePasses.h"
+#include "llvm/Pass.h"
+#include "llvm/Support/ErrorHandling.h"
+#include <iterator>
+
+using namespace llvm;
+
+#define DEBUG_TYPE "spirv-fixup-merge-terminators"
+
+namespace {
+
+class SPIRVFixupMergeTerminators final : public MachineFunctionPass {
+public:
+  static char ID;
+
+  SPIRVFixupMergeTerminators() : MachineFunctionPass(ID) {
+    initializeSPIRVFixupMergeTerminatorsPass(
+        *PassRegistry::getPassRegistry());
+  }
+
+  bool runOnMachineFunction(MachineFunction &MF) override;
+
+  StringRef getPassName() const override {
+    return "SPIR-V merge terminator fixup";
+  }
+};
+
+bool isValidMergeTerminator(unsigned MergeOpcode, unsigned TerminatorOpcode) {
+  switch (MergeOpcode) {
+  case SPIRV::OpLoopMerge:
+    return TerminatorOpcode == SPIRV::OpBranch ||
+           TerminatorOpcode == SPIRV::OpBranchConditional;
+  case SPIRV::OpSelectionMerge:
+    return TerminatorOpcode == SPIRV::OpBranchConditional ||
+           TerminatorOpcode == SPIRV::OpSwitch;
+  default:
+    llvm_unreachable("expected a SPIR-V merge instruction");
+  }
+}
+
+bool SPIRVFixupMergeTerminators::runOnMachineFunction(MachineFunction &MF) {
+  bool Changed = false;
+  for (MachineBasicBlock &MBB : MF) {
+    MachineInstr *Merge = nullptr;
+    for (MachineInstr &MI : MBB) {
+      if (MI.getOpcode() != SPIRV::OpLoopMerge &&
+          MI.getOpcode() != SPIRV::OpSelectionMerge)
+        continue;
+      if (Merge)
+        report_fatal_error("multiple SPIR-V merge instructions in one block");
+      Merge = &MI;
+    }
+    if (!Merge)
+      continue;
+
+    MachineBasicBlock::iterator Terminator = MBB.getLastNonDebugInstr();
+    if (Terminator == MBB.end() ||
+        !isValidMergeTerminator(Merge->getOpcode(), Terminator->getOpcode()))
+      report_fatal_error("invalid SPIR-V merge terminator");
+
+    if (std::next(Merge->getIterator()) == Terminator)
+      continue;
+    MBB.splice(Terminator, &MBB, Merge->getIterator());
+    Changed = true;
+  }
+  return Changed;
+}
+
+} // namespace
+
+char SPIRVFixupMergeTerminators::ID = 0;
+
+INITIALIZE_PASS(SPIRVFixupMergeTerminators, DEBUG_TYPE,
+                "SPIR-V merge terminator fixup", false, false)
+
+FunctionPass *llvm::createSPIRVFixupMergeTerminatorsPass() {
+  return new SPIRVFixupMergeTerminators();
+}
diff --git a/llvm/lib/Target/SPIRV/SPIRVTargetMachine.cpp b/llvm/lib/Target/SPIRV/SPIRVTargetMachine.cpp
