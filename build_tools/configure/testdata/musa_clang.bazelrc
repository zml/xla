build --config musa
build:musa --repo_env MUSA_PATH=/usr/local/musa
build:musa --repo_env MUSA_VERSION=4.2.0
build:musa --repo_env MUSA_GPU_ARCHS=mp_21,mp_22
build --action_env PYTHON_BIN_PATH=/usr/bin/python3
build --python_path /usr/bin/python3
test --test_env LD_LIBRARY_PATH
test --test_size_filters small,medium
build --copt -Wno-sign-compare
build --copt -Wno-error=unused-command-line-argument
build --copt -Wno-gnu-offsetof-extensions
build --build_tag_filters -no_oss,-cuda-only,-rocm-only,-oneapi-only
build --test_tag_filters -no_oss,-cuda-only,-rocm-only,-oneapi-only
test --build_tag_filters -no_oss,-cuda-only,-rocm-only,-oneapi-only
test --test_tag_filters -no_oss,-cuda-only,-rocm-only,-oneapi-only
