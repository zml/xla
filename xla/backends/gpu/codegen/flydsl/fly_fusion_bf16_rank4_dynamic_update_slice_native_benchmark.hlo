HloModule fly_fusion_bf16_rank4_dynamic_update_slice_native_benchmark

%fused_dynamic_update_slice (
    input: bf16[2,4,2048,8192], update: bf16[1,3,2046,8190],
    start0: s32[], start1: s32[], start2: s32[], start3: s32[])
    -> bf16[2,4,2048,8192] {
  %input = bf16[2,4,2048,8192]{3,2,1,0} parameter(0)
  %update = bf16[1,3,2046,8190]{3,2,1,0} parameter(1)
  %start0 = s32[] parameter(2)
  %start1 = s32[] parameter(3)
  %start2 = s32[] parameter(4)
  %start3 = s32[] parameter(5)
  %absolute = bf16[1,3,2046,8190]{3,2,1,0} abs(%update)
  ROOT %result = bf16[2,4,2048,8192]{3,2,1,0} dynamic-update-slice(
    %input, %absolute, %start0, %start1, %start2, %start3)
}

ENTRY %entry_computation (
    input: bf16[2,4,2048,8192], update: bf16[1,3,2046,8190],
    start0: s32[], start1: s32[], start2: s32[], start3: s32[])
    -> bf16[2,4,2048,8192] {
  %input = bf16[2,4,2048,8192]{3,2,1,0} parameter(0)
  %update = bf16[1,3,2046,8190]{3,2,1,0} parameter(1)
  %start0 = s32[] parameter(2)
  %start1 = s32[] parameter(3)
  %start2 = s32[] parameter(4)
  %start3 = s32[] parameter(5)
  ROOT %fusion = bf16[2,4,2048,8192]{3,2,1,0} fusion(
    %input, %update, %start0, %start1, %start2, %start3), kind=kLoop,
    calls=%fused_dynamic_update_slice
}
