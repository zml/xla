HloModule fly_fusion_bf16_transpose_4096_benchmark

%fused_transpose (p0: bf16[4096,4096]) -> bf16[4096,4096] {
  %p0 = bf16[4096,4096]{1,0} parameter(0)
  ROOT %transpose = bf16[4096,4096]{1,0} transpose(%p0), dimensions={1,0}
}

ENTRY %entry_computation (p0: bf16[4096,4096]) -> bf16[4096,4096] {
  %p0 = bf16[4096,4096]{1,0} parameter(0)
  ROOT %fusion = bf16[4096,4096]{1,0} fusion(%p0), kind=kCustom,
    calls=%fused_transpose,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["64","64"]}],"num_warps":"4","num_ctas":1,"num_stages":1}}}
}
