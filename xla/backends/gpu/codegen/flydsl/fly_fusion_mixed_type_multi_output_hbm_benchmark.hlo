HloModule fly_fusion_mixed_type_multi_output_hbm_benchmark

%fused_elementwise (p0: f32[8192,8192], p1: f32[8192,8192]) -> (f32[8192,8192], bf16[8192,8192]) {
  %p0 = f32[8192,8192]{1,0} parameter(0)
  %p1 = f32[8192,8192]{1,0} parameter(1)
  %sum = f32[8192,8192]{1,0} add(%p0, %p1)
  %narrowed = bf16[8192,8192]{1,0} convert(%sum)
  ROOT %tuple = (f32[8192,8192]{1,0}, bf16[8192,8192]{1,0})
    tuple(%sum, %narrowed)
}

ENTRY %entry_computation (p0: f32[8192,8192], p1: f32[8192,8192]) -> (f32[8192,8192], bf16[8192,8192]) {
  %p0 = f32[8192,8192]{1,0} parameter(0)
  %p1 = f32[8192,8192]{1,0} parameter(1)
  ROOT %fusion = (f32[8192,8192]{1,0}, bf16[8192,8192]{1,0})
    fusion(%p0, %p1), kind=kCustom, calls=%fused_elementwise,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","256"]},{"sizes":["1","256"]}],"num_warps":"4","num_ctas":1,"num_stages":1}}}
}
