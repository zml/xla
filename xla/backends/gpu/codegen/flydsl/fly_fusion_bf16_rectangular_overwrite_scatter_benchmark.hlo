HloModule fly_fusion_bf16_rectangular_overwrite_scatter_benchmark

assign {
  old = bf16[] parameter(0)
  ROOT update = bf16[] parameter(1)
}

elementwise {
  base = bf16[32768,4,1023]{2,1,0} parameter(0)
  updates = bf16[32768,1,3,511]{3,2,1,0} parameter(1)
  transformed = bf16[32768,1,3,511]{3,2,1,0} abs(updates)
  indices = s32[32768,1]{1,0} iota(), iota_dimension=0
  ROOT scatter = bf16[32768,4,1023]{2,1,0}
    scatter(base, indices, transformed),
    update_window_dims={1,2,3}, inserted_window_dims={},
    scatter_dims_to_operand_dims={0}, index_vector_dim=1,
    unique_indices=true, to_apply=assign
}

ENTRY main {
  base = bf16[32768,4,1023]{2,1,0} parameter(0)
  updates = bf16[32768,1,3,511]{3,2,1,0} parameter(1)
  ROOT fusion = bf16[32768,4,1023]{2,1,0}
    fusion(base, updates), kind=kInput, calls=elementwise
}
