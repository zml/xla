HloModule fly_fusion_bf16_non_unique_additive_scatter_benchmark

add {
  old = bf16[] parameter(0)
  update = bf16[] parameter(1)
  ROOT result = bf16[] add(old, update)
}

elementwise {
  base = bf16[32768,1024]{1,0} parameter(0)
  updates = bf16[65536,1024]{1,0} parameter(1)
  transformed = bf16[65536,1024]{1,0} abs(updates)
  canonical_updates = bf16[65536,1,1024]{2,1,0} bitcast(transformed)
  row_ids = s32[65536]{0} iota(), iota_dimension=0
  multiplier = s32[] constant(31337)
  multipliers = s32[65536]{0} broadcast(multiplier), dimensions={}
  permuted = s32[65536]{0} multiply(row_ids, multipliers)
  mask_value = s32[] constant(32767)
  mask = s32[65536]{0} broadcast(mask_value), dimensions={}
  bounded = s32[65536]{0} and(permuted, mask)
  canonical_indices = s32[65536,1]{1,0} bitcast(bounded)
  ROOT scatter = bf16[32768,1024]{1,0}
    scatter(base, canonical_indices, canonical_updates),
    update_window_dims={1,2}, inserted_window_dims={},
    scatter_dims_to_operand_dims={0}, index_vector_dim=1,
    unique_indices=false, to_apply=add
}

ENTRY main {
  base = bf16[32768,1024]{1,0} parameter(0)
  updates = bf16[65536,1024]{1,0} parameter(1)
  ROOT fusion = bf16[32768,1024]{1,0} fusion(base, updates), kind=kInput,
    calls=elementwise
}
