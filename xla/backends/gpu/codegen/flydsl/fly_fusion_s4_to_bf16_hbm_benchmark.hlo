HloModule fly_fusion_s4_to_bf16_hbm_benchmark

%fused_conversion (p0: s4[67108864]) -> bf16[67108864] {
  %p0 = s4[67108864]{0:E(4)} parameter(0)
  %widened = s8[67108864]{0} convert(%p0)
  %converted = bf16[67108864]{0} convert(%widened)
  %magnitude = bf16[67108864]{0} abs(%converted)
  %scale = bf16[] constant(0.5)
  %scales = bf16[67108864]{0} broadcast(%scale), dimensions={}
  ROOT %result = bf16[67108864]{0} multiply(%magnitude, %scales)
}

ENTRY %entry_computation (p0: s4[67108864]) -> bf16[67108864] {
  %p0 = s4[67108864]{0:E(4)} parameter(0)
  ROOT %fusion = bf16[67108864]{0} fusion(%p0), kind=kCustom,
    calls=%fused_conversion,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
