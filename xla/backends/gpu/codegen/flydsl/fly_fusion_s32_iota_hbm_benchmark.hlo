HloModule fly_fusion_s32_iota_hbm_benchmark

%fused_iota (p0: s32[8192,8192]) -> s32[8192,8192] {
  %p0 = s32[8192,8192]{1,0} parameter(0)
  %row = s32[8192,8192]{1,0} iota(), iota_dimension=0
  ROOT %result = s32[8192,8192]{1,0} add(%p0, %row)
}

ENTRY %entry_computation (p0: s32[8192,8192]) -> s32[8192,8192] {
  %p0 = s32[8192,8192]{1,0} parameter(0)
  ROOT %fusion = s32[8192,8192]{1,0} fusion(%p0), kind=kCustom,
    calls=%fused_iota,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
