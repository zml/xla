HloModule fly_fusion_bf16_transpose_benchmark

%fused_transpose (p0: bf16[8192,16384]) -> bf16[16384,8192] {
  %p0 = bf16[8192,16384]{1,0} parameter(0)
  ROOT %transpose = bf16[16384,8192]{1,0} transpose(%p0), dimensions={1,0}
}

ENTRY %entry_computation (p0: bf16[8192,16384]) -> bf16[16384,8192] {
  %p0 = bf16[8192,16384]{1,0} parameter(0)
  ROOT %fusion = bf16[16384,8192]{1,0} fusion(%p0), kind=kInput,
    calls=%fused_transpose
}
