HloModule fly_fusion_s8_to_s4_hbm_benchmark

%fused_conversion (p0: s8[67108865]) -> s4[67108865] {
  %p0 = s8[67108865]{0} parameter(0)
  %bias = s8[] constant(9)
  %biases = s8[67108865]{0} broadcast(%bias), dimensions={}
  %shifted = s8[67108865]{0} add(%p0, %biases)
  ROOT %result = s4[67108865]{0:E(4)} convert(%shifted)
}

ENTRY %entry_computation (p0: s8[67108865]) -> s4[67108865] {
  %p0 = s8[67108865]{0} parameter(0)
  ROOT %fusion = s4[67108865]{0:E(4)} fusion(%p0), kind=kLoop,
    calls=%fused_conversion
}
