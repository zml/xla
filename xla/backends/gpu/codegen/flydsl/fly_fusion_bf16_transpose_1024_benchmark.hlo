HloModule fly_fusion_bf16_transpose_1024_benchmark

%fused_transpose (p0: bf16[1024,1024]) -> bf16[1024,1024] {
  %p0 = bf16[1024,1024]{1,0} parameter(0)
  ROOT %transpose = bf16[1024,1024]{1,0} transpose(%p0), dimensions={1,0}
}

ENTRY %entry_computation (p0: bf16[1024,1024]) -> bf16[1024,1024] {
  %p0 = bf16[1024,1024]{1,0} parameter(0)
  ROOT %fusion = bf16[1024,1024]{1,0} fusion(%p0), kind=kInput,
    calls=%fused_transpose
}
