HloModule fly_fusion_row_reduction_benchmark

%add (lhs: f32[], rhs: f32[]) -> f32[] {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  ROOT %sum = f32[] add(%lhs, %rhs)
}

%fused_reduction (p0: f32[65536,4096]) -> f32[65536] {
  %p0 = f32[65536,4096]{1,0} parameter(0)
  %zero = f32[] constant(0)
  ROOT %reduce = f32[65536]{0} reduce(%p0, %zero), dimensions={1},
    to_apply=%add
}

ENTRY %entry_computation (p0: f32[65536,4096]) -> f32[65536] {
  %p0 = f32[65536,4096]{1,0} parameter(0)
  ROOT %fusion = f32[65536]{0} fusion(%p0), kind=kInput,
    calls=%fused_reduction
}
