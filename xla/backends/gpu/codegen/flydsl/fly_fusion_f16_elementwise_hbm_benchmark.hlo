HloModule fly_fusion_f16_elementwise_hbm_benchmark

%fused_elementwise (p0: f16[8192,8192], p1: f16[8192,8192]) -> f16[8192,8192] {
  %p0 = f16[8192,8192]{1,0} parameter(0)
  %p1 = f16[8192,8192]{1,0} parameter(1)
  %add = f16[8192,8192]{1,0} add(%p0, %p1)
  %scale = f16[] constant(1.5)
  %broadcast = f16[8192,8192]{1,0} broadcast(%scale), dimensions={}
  %multiply = f16[8192,8192]{1,0} multiply(%add, %broadcast)
  ROOT %maximum = f16[8192,8192]{1,0} maximum(%multiply, %p0)
}

ENTRY %entry_computation (p0: f16[8192,8192], p1: f16[8192,8192]) -> f16[8192,8192] {
  %p0 = f16[8192,8192]{1,0} parameter(0)
  %p1 = f16[8192,8192]{1,0} parameter(1)
  ROOT %fusion = f16[8192,8192]{1,0} fusion(%p0, %p1), kind=kCustom,
    calls=%fused_elementwise,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
