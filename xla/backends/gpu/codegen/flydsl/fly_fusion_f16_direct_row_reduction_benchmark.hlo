HloModule fly_fusion_f16_direct_row_reduction_benchmark

%maximum (lhs: f16[], rhs: f16[]) -> f16[] {
  %lhs = f16[] parameter(0)
  %rhs = f16[] parameter(1)
  ROOT %max = f16[] maximum(%lhs, %rhs)
}

%fused_reduction (p0: f16[131072,4096]) -> f16[131072] {
  %p0 = f16[131072,4096]{1,0} parameter(0)
  %minus_inf = f16[] constant(-inf)
  ROOT %reduce = f16[131072]{0} reduce(%p0, %minus_inf), dimensions={1},
    to_apply=%maximum
}

ENTRY %entry_computation (p0: f16[131072,4096]) -> f16[131072] {
  %p0 = f16[131072,4096]{1,0} parameter(0)
  ROOT %fusion = f16[131072]{0} fusion(%p0), kind=kCustom,
    calls=%fused_reduction,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["8"]}],"num_warps":"8","num_ctas":1,"num_stages":1}}}
}
