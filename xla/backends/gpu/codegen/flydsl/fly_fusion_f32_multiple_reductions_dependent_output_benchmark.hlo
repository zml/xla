HloModule fly_fusion_f32_multiple_reductions_dependent_output_benchmark

add {
  lhs = f32[] parameter(0)
  rhs = f32[] parameter(1)
  ROOT sum = f32[] add(lhs, rhs)
}

maximum {
  lhs = f32[] parameter(0)
  rhs = f32[] parameter(1)
  ROOT max = f32[] maximum(lhs, rhs)
}

reduction {
  p0 = f32[262144,512]{1,0} parameter(0)
  squared = f32[262144,512]{1,0} multiply(p0, p0)
  zero = f32[] constant(0)
  row_sum = f32[262144]{0} reduce(squared, zero), dimensions={1},
    to_apply=add
  minus_inf = f32[] constant(-inf)
  row_max = f32[262144]{0} reduce(p0, minus_inf), dimensions={1},
    to_apply=maximum
  epsilon = f32[] constant(1e-6)
  epsilons = f32[262144]{0} broadcast(epsilon), dimensions={}
  variance = f32[262144]{0} add(row_sum, epsilons)
  scale = f32[262144]{0} rsqrt(variance)
  scales = f32[262144,512]{1,0} broadcast(scale), dimensions={0}
  maxima = f32[262144,512]{1,0} broadcast(row_max), dimensions={0}
  centered = f32[262144,512]{1,0} subtract(p0, maxima)
  normalized = f32[262144,512]{1,0} multiply(centered, scales)
  ROOT result = (f32[262144,512]{1,0}, f32[262144]{0}, f32[262144]{0})
    tuple(normalized, row_max, row_sum)
}

ENTRY main {
  p0 = f32[262144,512]{1,0} parameter(0)
  ROOT fusion = (f32[262144,512]{1,0}, f32[262144]{0}, f32[262144]{0})
    fusion(p0), kind=kCustom, calls=reduction,
    backend_config={"fusion_backend_config":{"kind":"__fly"}}
}
