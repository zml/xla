HloModule fly_fusion_bf16_scan_256_preconfigured_benchmark

scan_computation {
  input = bf16[262144,256]{1,0} parameter(0)
  ROOT scan = bf16[262144,256]{1,0} custom-call(input),
    custom_call_target="__fly$scan",
    backend_config={"vector_length":1,"row_length":256,
      "column_length":262144,"kind":1,"is_reverse":false}
}

ENTRY main {
  input = bf16[262144,256]{1,0} parameter(0)
  ROOT fusion = bf16[262144,256]{1,0} fusion(input), kind=kCustom,
    calls=scan_computation,
    backend_config={"fusion_backend_config":{"kind":"__fly",
      "block_level_fusion_config":{"output_tiles":[{"sizes":["1","1"]}],
      "num_warps":"2","num_ctas":"1","num_stages":"1",
      "waves_per_eu":"0"}}}
}
