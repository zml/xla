HloModule fly_fusion_f32_row_reduction_extra_output_benchmark

maximum {
  lhs = f32[] parameter(0)
  rhs = f32[] parameter(1)
  ROOT max = f32[] maximum(lhs, rhs)
}

reduction {
  p0 = f32[262144,512]{1,0} parameter(0)
  absolute = f32[262144,512]{1,0} abs(p0)
  minus_inf = f32[] constant(-inf)
  row_max = f32[262144]{0} reduce(absolute, minus_inf), dimensions={1},
    to_apply=maximum
  ROOT result = (f32[262144]{0}, f32[262144,512]{1,0})
    tuple(row_max, absolute)
}

ENTRY main {
  p0 = f32[262144,512]{1,0} parameter(0)
  ROOT fusion = (f32[262144]{0}, f32[262144,512]{1,0})
    fusion(p0), kind=kCustom, calls=reduction,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["64"]},{"sizes":["64","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
