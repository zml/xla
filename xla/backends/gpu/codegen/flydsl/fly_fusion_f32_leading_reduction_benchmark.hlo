HloModule fly_fusion_f32_leading_reduction_benchmark

%add (lhs: f32[], rhs: f32[]) -> f32[] {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  ROOT %sum = f32[] add(%lhs, %rhs)
}

%fused_reduction (p0: f32[17,4194304]) -> f32[4194304] {
  %p0 = f32[17,4194304]{1,0} parameter(0)
  %zero = f32[] constant(0)
  ROOT %reduce = f32[4194304]{0} reduce(%p0, %zero), dimensions={0},
    to_apply=%add
}

ENTRY %entry_computation (p0: f32[17,4194304]) -> f32[4194304] {
  %p0 = f32[17,4194304]{1,0} parameter(0)
  ROOT %fusion = f32[4194304]{0} fusion(%p0), kind=kCustom,
    calls=%fused_reduction,
    backend_config={"fusion_backend_config":{"kind":"__fly","block_level_fusion_config":{"num_warps":"4","output_tiles":[{"sizes":["1"]}],"num_ctas":1,"num_stages":1,"vector_size_bits":128}}}
}
