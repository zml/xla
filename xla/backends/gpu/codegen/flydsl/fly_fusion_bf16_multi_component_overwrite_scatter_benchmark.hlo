HloModule fly_fusion_bf16_multi_component_overwrite_scatter_benchmark

assign {
  old = bf16[] parameter(0)
  ROOT update = bf16[] parameter(1)
}

elementwise {
  base = bf16[256,256,1023]{2,1,0} parameter(0)
  updates = bf16[65536,1023]{1,0} parameter(1)
  transformed = bf16[65536,1023]{1,0} abs(updates)
  canonical_updates = bf16[65536,1,1,1023]{3,2,1,0}
    bitcast(transformed)
  row_ids = s32[65536]{0} iota(), iota_dimension=0
  multiplier = s32[] constant(31337)
  multipliers = s32[65536]{0} broadcast(multiplier), dimensions={}
  permuted = s32[65536]{0} multiply(row_ids, multipliers)
  mask_value = s32[] constant(65535)
  mask = s32[65536]{0} broadcast(mask_value), dimensions={}
  bounded = s32[65536]{0} and(permuted, mask)
  radix_value = s32[] constant(256)
  radix = s32[65536]{0} broadcast(radix_value), dimensions={}
  major = s32[65536]{0} divide(bounded, radix)
  minor = s32[65536]{0} remainder(bounded, radix)
  major_column = s32[65536,1]{1,0} bitcast(major)
  minor_column = s32[65536,1]{1,0} bitcast(minor)
  canonical_indices = s32[65536,2]{1,0}
    concatenate(major_column, minor_column), dimensions={1}
  ROOT scatter = bf16[256,256,1023]{2,1,0}
    scatter(base, canonical_indices, canonical_updates),
    update_window_dims={1,2,3}, inserted_window_dims={},
    scatter_dims_to_operand_dims={0,1}, index_vector_dim=1,
    unique_indices=true, to_apply=assign
}

ENTRY main {
  base = bf16[256,256,1023]{2,1,0} parameter(0)
  updates = bf16[65536,1023]{1,0} parameter(1)
  ROOT fusion = bf16[256,256,1023]{2,1,0}
    fusion(base, updates), kind=kInput, calls=elementwise
}
