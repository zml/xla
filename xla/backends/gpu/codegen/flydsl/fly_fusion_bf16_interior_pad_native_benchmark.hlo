HloModule fly_fusion_bf16_interior_pad_native_benchmark

%fused_interior_pad (p0: bf16[16384,4096]) -> bf16[16384,8192] {
  %p0 = bf16[16384,4096]{1,0} parameter(0)
  %absolute = bf16[16384,4096]{1,0} abs(%p0)
  %zero = bf16[] constant(0)
  ROOT %result = bf16[16384,8192]{1,0} pad(%absolute, %zero),
    padding=0_0x0_1_1
}

ENTRY %entry_computation (p0: bf16[16384,4096]) -> bf16[16384,8192] {
  %p0 = bf16[16384,4096]{1,0} parameter(0)
  ROOT %fusion = bf16[16384,8192]{1,0} fusion(%p0), kind=kLoop,
    calls=%fused_interior_pad
}
