HloModule fly_fusion_s8_bitcast_convert_hbm_benchmark

%fused_bitcast (p0: s32[16777216]) -> s8[16777216,4] {
  %p0 = s32[16777216]{0} parameter(0)
  %bytes = s8[16777216,4]{1,0} bitcast-convert(%p0)
  ROOT %result = s8[16777216,4]{1,0} not(%bytes)
}

ENTRY %entry_computation (p0: s32[16777216]) -> s8[16777216,4] {
  %p0 = s32[16777216]{0} parameter(0)
  ROOT %fusion = s8[16777216,4]{1,0} fusion(%p0), kind=kCustom,
    calls=%fused_bitcast,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["16","32"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
