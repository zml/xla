HloModule fly_fusion_bf16_rank4_rectangular_slice_benchmark

%fused_rectangular_slice (p0: bf16[2,4,2048,8194]) -> bf16[2,4,2048,8192] {
  %p0 = bf16[2,4,2048,8194]{3,2,1,0} parameter(0)
  %absolute = bf16[2,4,2048,8194]{3,2,1,0} abs(%p0)
  ROOT %result = bf16[2,4,2048,8192]{3,2,1,0} slice(%absolute),
    slice={[0:2], [0:4], [0:2048], [1:8193]}
}

ENTRY %entry_computation (p0: bf16[2,4,2048,8194]) -> bf16[2,4,2048,8192] {
  %p0 = bf16[2,4,2048,8194]{3,2,1,0} parameter(0)
  ROOT %fusion = bf16[2,4,2048,8192]{3,2,1,0} fusion(%p0),
    kind=kCustom, calls=%fused_rectangular_slice,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","1","1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
