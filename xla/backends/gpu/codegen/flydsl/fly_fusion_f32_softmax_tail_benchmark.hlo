HloModule fly_fusion_f32_softmax_tail_benchmark

%maximum (lhs: f32[], rhs: f32[]) -> f32[] {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  ROOT %max = f32[] maximum(%lhs, %rhs)
}

%add (lhs: f32[], rhs: f32[]) -> f32[] {
  %lhs = f32[] parameter(0)
  %rhs = f32[] parameter(1)
  ROOT %sum = f32[] add(%lhs, %rhs)
}

%fused_softmax (p0: f32[65536,4093]) -> f32[65536,4093] {
  %p0 = f32[65536,4093]{1,0} parameter(0)
  %minus_inf = f32[] constant(-inf)
  %row_max = f32[65536]{0} reduce(%p0, %minus_inf), dimensions={1},
    to_apply=%maximum
  %broadcast_max = f32[65536,4093]{1,0} broadcast(%row_max), dimensions={0}
  %shifted = f32[65536,4093]{1,0} subtract(%p0, %broadcast_max)
  %exponential = f32[65536,4093]{1,0} exponential(%shifted)
  %zero = f32[] constant(0)
  %row_sum = f32[65536]{0} reduce(%exponential, %zero), dimensions={1},
    to_apply=%add
  %broadcast_sum = f32[65536,4093]{1,0} broadcast(%row_sum), dimensions={0}
  ROOT %result = f32[65536,4093]{1,0} divide(%exponential, %broadcast_sum)
}

ENTRY %entry_computation (p0: f32[65536,4093]) -> f32[65536,4093] {
  %p0 = f32[65536,4093]{1,0} parameter(0)
  ROOT %fusion = f32[65536,4093]{1,0} fusion(%p0), kind=kCustom,
    calls=%fused_softmax,
    backend_config={"fusion_backend_config":{"kind":"__triton"}}
}
