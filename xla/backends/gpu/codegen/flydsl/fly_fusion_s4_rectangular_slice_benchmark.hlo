HloModule fly_fusion_s4_rectangular_slice_benchmark

%fused_rectangular_slice (p0: s4[16384,8194]) -> bf16[16384,8192] {
  %p0 = s4[16384,8194]{1,0:E(4)} parameter(0)
  %sliced = s4[16384,8192]{1,0:E(4)} slice(%p0),
    slice={[0:16384], [1:8193]}
  %widened = s8[16384,8192]{1,0} convert(%sliced)
  %converted = bf16[16384,8192]{1,0} convert(%widened)
  %magnitude = bf16[16384,8192]{1,0} abs(%converted)
  %scale = bf16[] constant(0.5)
  %scales = bf16[16384,8192]{1,0} broadcast(%scale), dimensions={}
  ROOT %result = bf16[16384,8192]{1,0} multiply(%magnitude, %scales)
}

ENTRY %entry_computation (p0: s4[16384,8194]) -> bf16[16384,8192] {
  %p0 = s4[16384,8194]{1,0:E(4)} parameter(0)
  ROOT %fusion = bf16[16384,8192]{1,0} fusion(%p0), kind=kCustom,
    calls=%fused_rectangular_slice,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
