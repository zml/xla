HloModule fly_fusion_s32_non_unique_maximum_scatter_benchmark

maximum {
  old = s32[] parameter(0)
  update = s32[] parameter(1)
  ROOT result = s32[] maximum(old, update)
}

elementwise {
  base = s32[16384,1024]{1,0} parameter(0)
  updates = s32[32768,1024]{1,0} parameter(1)
  canonical_updates = s32[32768,1,1024]{2,1,0} bitcast(updates)
  row_ids = s32[32768]{0} iota(), iota_dimension=0
  multiplier = s32[] constant(31337)
  multipliers = s32[32768]{0} broadcast(multiplier), dimensions={}
  permuted = s32[32768]{0} multiply(row_ids, multipliers)
  mask_value = s32[] constant(16383)
  mask = s32[32768]{0} broadcast(mask_value), dimensions={}
  bounded = s32[32768]{0} and(permuted, mask)
  canonical_indices = s32[32768,1]{1,0} bitcast(bounded)
  ROOT scatter = s32[16384,1024]{1,0}
    scatter(base, canonical_indices, canonical_updates),
    update_window_dims={1,2}, inserted_window_dims={},
    scatter_dims_to_operand_dims={0}, index_vector_dim=1,
    unique_indices=false, to_apply=maximum
}

ENTRY main {
  base = s32[16384,1024]{1,0} parameter(0)
  updates = s32[32768,1024]{1,0} parameter(1)
  ROOT fusion = s32[16384,1024]{1,0} fusion(base, updates), kind=kInput,
    calls=elementwise
}
