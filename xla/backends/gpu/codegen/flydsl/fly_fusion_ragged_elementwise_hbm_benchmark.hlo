HloModule fly_fusion_ragged_elementwise_hbm_benchmark

%fused_elementwise (p0: bf16[16383,8191], p1: bf16[16383,8191]) -> bf16[16383,8191] {
  %p0 = bf16[16383,8191]{1,0} parameter(0)
  %p1 = bf16[16383,8191]{1,0} parameter(1)
  %add = bf16[16383,8191]{1,0} add(%p0, %p1)
  %scale = bf16[] constant(1.5)
  %broadcast = bf16[16383,8191]{1,0} broadcast(%scale), dimensions={}
  %multiply = bf16[16383,8191]{1,0} multiply(%add, %broadcast)
  ROOT %maximum = bf16[16383,8191]{1,0} maximum(%multiply, %p0)
}

ENTRY %entry_computation (p0: bf16[16383,8191], p1: bf16[16383,8191]) -> bf16[16383,8191] {
  %p0 = bf16[16383,8191]{1,0} parameter(0)
  %p1 = bf16[16383,8191]{1,0} parameter(1)
  ROOT %fusion = bf16[16383,8191]{1,0} fusion(%p0, %p1), kind=kCustom,
    calls=%fused_elementwise,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
