HloModule fly_fusion_bf16_transformer_context_transpose_benchmark

%fused_transpose (p0: bf16[32,64,128]) -> bf16[2,128,16,64] {
  %p0 = bf16[32,64,128]{2,1,0} parameter(0)
  %view = bf16[2,16,64,128]{3,2,1,0} bitcast(%p0)
  ROOT %transpose = bf16[2,128,16,64]{3,2,1,0} transpose(%view),
    dimensions={0,3,1,2}
}

ENTRY %entry_computation (p0: bf16[32,64,128]) -> bf16[2,128,16,64] {
  %p0 = bf16[32,64,128]{2,1,0} parameter(0)
  ROOT %fusion = bf16[2,128,16,64]{3,2,1,0} fusion(%p0), kind=kInput,
    calls=%fused_transpose
}
