HloModule fly_fusion_pred_elementwise_hbm_benchmark

%fused_elementwise (p0: pred[8192,8192], p1: s32[8192,8192]) -> pred[8192,8192] {
  %p0 = pred[8192,8192]{1,0} parameter(0)
  %p1 = s32[8192,8192]{1,0} parameter(1)
  %p0_s32 = s32[8192,8192]{1,0} convert(%p0)
  %sum = s32[8192,8192]{1,0} add(%p0_s32, %p1)
  ROOT %result = pred[8192,8192]{1,0} convert(%sum)
}

ENTRY %entry_computation (p0: pred[8192,8192], p1: s32[8192,8192]) -> pred[8192,8192] {
  %p0 = pred[8192,8192]{1,0} parameter(0)
  %p1 = s32[8192,8192]{1,0} parameter(1)
  ROOT %fusion = pred[8192,8192]{1,0} fusion(%p0, %p1), kind=kCustom,
    calls=%fused_elementwise,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
