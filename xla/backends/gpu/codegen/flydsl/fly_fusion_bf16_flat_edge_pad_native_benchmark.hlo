HloModule fly_fusion_bf16_flat_edge_pad_native_benchmark

%fused_flat_edge_pad (p0: bf16[134217726]) -> bf16[134217728] {
  %p0 = bf16[134217726]{0} parameter(0)
  %absolute = bf16[134217726]{0} abs(%p0)
  %zero = bf16[] constant(0)
  ROOT %result = bf16[134217728]{0} pad(%absolute, %zero), padding=0_2
}

ENTRY %entry_computation (p0: bf16[134217726]) -> bf16[134217728] {
  %p0 = bf16[134217726]{0} parameter(0)
  ROOT %fusion = bf16[134217728]{0} fusion(%p0), kind=kLoop,
    calls=%fused_flat_edge_pad
}
