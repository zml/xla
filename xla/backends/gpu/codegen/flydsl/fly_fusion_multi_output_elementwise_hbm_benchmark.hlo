HloModule fly_fusion_multi_output_elementwise_hbm_benchmark

%fused_elementwise (p0: bf16[16384,8192], p1: bf16[16384,8192]) -> (bf16[16384,8192], bf16[16384,8192]) {
  %p0 = bf16[16384,8192]{1,0} parameter(0)
  %p1 = bf16[16384,8192]{1,0} parameter(1)
  %sum = bf16[16384,8192]{1,0} add(%p0, %p1)
  %product = bf16[16384,8192]{1,0} multiply(%sum, %p0)
  ROOT %tuple = (bf16[16384,8192]{1,0}, bf16[16384,8192]{1,0})
    tuple(%sum, %product)
}

ENTRY %entry_computation (p0: bf16[16384,8192], p1: bf16[16384,8192]) -> (bf16[16384,8192], bf16[16384,8192]) {
  %p0 = bf16[16384,8192]{1,0} parameter(0)
  %p1 = bf16[16384,8192]{1,0} parameter(1)
  ROOT %fusion = (bf16[16384,8192]{1,0}, bf16[16384,8192]{1,0})
    fusion(%p0, %p1), kind=kCustom, calls=%fused_elementwise,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","256"]},{"sizes":["1","256"]}],"num_warps":"4","num_ctas":1,"num_stages":1}}}
}
