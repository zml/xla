HloModule fly_fusion_bf16_rank4_dynamic_slice_benchmark

%fused_dynamic_slice (p0: bf16[4,6,2050,8194], start0: s32[], start1: s32[], start2: s32[], start3: s32[]) -> bf16[2,4,2048,8192] {
  %p0 = bf16[4,6,2050,8194]{3,2,1,0} parameter(0)
  %start0 = s32[] parameter(1)
  %start1 = s32[] parameter(2)
  %start2 = s32[] parameter(3)
  %start3 = s32[] parameter(4)
  %absolute = bf16[4,6,2050,8194]{3,2,1,0} abs(%p0)
  ROOT %result = bf16[2,4,2048,8192]{3,2,1,0} dynamic-slice(
    %absolute, %start0, %start1, %start2, %start3),
    dynamic_slice_sizes={2,4,2048,8192}
}

ENTRY %entry_computation (p0: bf16[4,6,2050,8194], start0: s32[], start1: s32[], start2: s32[], start3: s32[]) -> bf16[2,4,2048,8192] {
  %p0 = bf16[4,6,2050,8194]{3,2,1,0} parameter(0)
  %start0 = s32[] parameter(1)
  %start1 = s32[] parameter(2)
  %start2 = s32[] parameter(3)
  %start3 = s32[] parameter(4)
  ROOT %fusion = bf16[2,4,2048,8192]{3,2,1,0} fusion(
    %p0, %start0, %start1, %start2, %start3), kind=kCustom,
    calls=%fused_dynamic_slice,
    backend_config={"fusion_backend_config":{"kind":"__triton","block_level_fusion_config":{"output_tiles":[{"sizes":["1","1","1","512"]}],"num_warps":"2","num_ctas":1,"num_stages":1}}}
}
