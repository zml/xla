HloModule fly_fusion_bf16_scan_256_benchmark

add {
  lhs = bf16[262144] parameter(0)
  rhs = bf16[262144] parameter(1)
  sum = bf16[262144] add(lhs, rhs)
  ROOT result = (bf16[262144], bf16[262144]) tuple(sum, sum)
}

ENTRY main {
  input = bf16[262144,256]{1,0} parameter(0)
  zero = bf16[] constant(0)
  init = bf16[262144]{0} broadcast(zero), dimensions={}
  scan = (bf16[262144,256]{1,0}, bf16[262144]{0}) scan(input, init),
    dimensions={1}, num_carries=1, is_associative=true, to_apply=add
  ROOT output = bf16[262144,256]{1,0} get-tuple-element(scan), index=0
}
